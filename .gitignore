# Ignore macOS system files
.DS_Store
**/.DS_Store

# Ignore Python bytecode directories
__pycache__/
**/__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Images generated by the app and the CLI
NST_Code/output/
NST_Code/static/uploads/

# Training runs (final_exp holds the shipped decoder and is kept)
NST_Code/experiment/*
!NST_Code/experiment/final_exp/

# Local backups
*.phase4-backup

# Test and tooling caches
.pytest_cache/
**/.pytest_cache/
.ipynb_checkpoints/

# Editor settings
.vscode/
**/.vscode/
